<Project>
  <!--
    Central package management: every NuGet version is set here, once, and project files carry only
    <PackageReference Include="..." /> with no Version. Applies to every project under src/.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- vNoder.App -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- vNoder.Nodes -->
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <!-- Pinned to 3.1: 4.x adds a build-time license-key check that fails Release builds without a key. -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- 2.1 is the line built on ImageSharp 3.1; Drawing 3.x needs ImageSharp 4. Same license as ImageSharp. -->
    <PackageVersion Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="MailKit" Version="4.18.0" />
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
    <PackageVersion Include="AngleSharp" Version="1.8.3" />
    <!-- Windows DPAPI, for the Secret node: on other platforms it throws, and the node says so. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>
</Project>