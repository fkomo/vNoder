<Window x:Class="vNoder.App.Views.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="Transparent" AllowsTransparency="True"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource WindowBackground}" BorderBrush="#FF4A4A58"
            BorderThickness="1" CornerRadius="7">
        <StackPanel>

            <!-- Own title bar: WindowStyle is None so the light system chrome never appears. -->
            <Border x:Name="TitleBar" Height="34" CornerRadius="6,6,0,0" Cursor="SizeAll"
                    Background="{StaticResource ToolbarBackground}"
                    BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Margin="14,0" VerticalAlignment="Center" FontSize="12"
                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
            </Border>

            <TextBlock x:Name="MessageText" Margin="16,14,16,0" TextWrapping="Wrap" FontSize="12"
                       LineHeight="18" Foreground="{StaticResource TextSecondary}" />

            <TextBox x:Name="ValueBox" Margin="16,12,16,0" Padding="6,4" FontSize="13"
                     Visibility="Collapsed" Style="{StaticResource NodeFieldTextBox}" />

            <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="16,18,16,16" />
        </StackPanel>
    </Border>
</Window>
