<Window x:Class="vNoder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:vNoder.App"
        xmlns:p="clr-namespace:vNoder.App.Presentation"
        xmlns:n="clr-namespace:vNoder.Nodes;assembly=vNoder.Nodes"
        Title="{Binding WindowTitle}" Height="760" Width="1220"
        Background="{StaticResource WindowBackground}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        KeyDown="Window_KeyDown"
        PreviewGotKeyboardFocus="Window_PreviewGotKeyboardFocus">

    <Window.InputBindings>
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RunOnceCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding ToggleContinuousCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="ApplicationCommands.SaveAs" />
        <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="ApplicationCommands.Redo" />
    </Window.InputBindings>

    <!-- New/Open/Save reuse the built-in Ctrl+N / Ctrl+O / Ctrl+S gestures, Undo/Redo Ctrl+Z / Ctrl+Y. Import
         is a command of the window's own, carrying its Ctrl+I gesture. -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="NewCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.Open" Executed="OpenCommand_Executed" />
        <CommandBinding Command="{x:Static local:MainWindow.ImportCommand}" Executed="ImportCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveAsCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.Copy" Executed="CopyCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.Paste" Executed="PasteCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.Undo" CanExecute="UndoCommand_CanExecute"
                        Executed="UndoCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.Redo" CanExecute="RedoCommand_CanExecute"
                        Executed="RedoCommand_Executed" />
    </Window.CommandBindings>

    <Window.Resources>

        <!-- ===== Ports ================================================================== -->

        <Style x:Key="PortDot" TargetType="Ellipse">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Stroke" Value="{Binding ValueType, Converter={StaticResource PortBrush}}" />
            <Setter Property="Fill" Value="{StaticResource CanvasBackground}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Fill" Value="{Binding ValueType, Converter={StaticResource PortBrush}}" />
                </DataTrigger>
                <!-- Last, so it wins: this is the port the cursor can act on right now. -->
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource TextPrimary}" />
                    <Setter Property="StrokeThickness" Value="3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Dot hangs half outside the node edge so wires meet it exactly at Node.X / Node.X+Width. -->
        <DataTemplate x:Key="InputPortTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent"
                        ToolTip="{Binding TypeLabel}">
                <Ellipse Style="{StaticResource PortDot}" Margin="-6,0,0,0"
                         MouseLeftButtonDown="InputPortDot_MouseLeftButtonDown" />
                <TextBlock Text="{Binding Name}" Margin="7,0,0,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource TextSecondary}" />
                <!-- The wire into this input runs the node once per item of its list. -->
                <TextBlock Text="&#x00D7;" Margin="4,0,0,0" VerticalAlignment="Center"
                           FontSize="12" FontWeight="Bold" Foreground="#FF5FD4C4"
                           Visibility="{Binding IsIterating, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="OutputPortTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"
                        Background="Transparent" ToolTip="{Binding TypeLabel}">
                <TextBlock Text="{Binding Name}" Margin="0,0,7,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource TextSecondary}" />
                <Ellipse Style="{StaticResource PortDot}" Margin="0,0,-6,0"
                         MouseLeftButtonDown="OutputPortDot_MouseLeftButtonDown" />
            </StackPanel>
        </DataTemplate>

        <!-- A row with a port on one side only: the empty side must draw nothing. Without this the
             port template is still instantiated for a null port and paints an unbound dot. -->
        <Style x:Key="PortSlot" TargetType="ContentControl">
            <Style.Triggers>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="PortRowTemplate">
            <Grid Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl Grid.Column="0" Content="{Binding Input}" Style="{StaticResource PortSlot}" HorizontalAlignment="Left"
                                VerticalAlignment="Center" ContentTemplate="{StaticResource InputPortTemplate}" />
                <ContentControl Grid.Column="1" Content="{Binding Output}" Style="{StaticResource PortSlot}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" ContentTemplate="{StaticResource OutputPortTemplate}" />
            </Grid>
        </DataTemplate>

        <!-- ===== Inline editors: one implicit template per editable node type ============ -->

        <DataTemplate x:Key="NoEditorTemplate" />

        <DataTemplate DataType="{x:Type n:StaticNumberNode}">
            <TextBox Style="{StaticResource NodeFieldTextBox}"
                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:StaticTextNode}">
            <TextBox Style="{StaticResource NodeFieldTextBox}" MinHeight="23"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:RandomNumberNode}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Min" Style="{StaticResource NodeFieldLabel}" />
                    <TextBox Style="{StaticResource NodeFieldTextBox}"
                             IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Min}"
                         Text="{Binding Min, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Max" Style="{StaticResource NodeFieldLabel}" />
                    <TextBox Style="{StaticResource NodeFieldTextBox}"
                             IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Max}"
                         Text="{Binding Max, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:RandomStringNode}">
            <StackPanel>
                <TextBlock Text="Length" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}"
                         IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Length}"
                         Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Charset" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}"
                         IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Charset}"
                         Text="{Binding Charset, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:RandomBytesNode}">
            <StackPanel>
                <TextBlock Text="Length" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}"
                         IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Length}"
                         Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:PathDeleteNode}">
            <StackPanel>
                <TextBlock Text="Path (file or directory)" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}"
                         IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Path}"
                         Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Recursive (with contents)" Margin="0,6,0,0" FontSize="10"
                          IsChecked="{Binding Recursive}" Foreground="{StaticResource TextMuted}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:FileReadNode}">
            <StackPanel>
                <TextBlock Text="Path" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}"
                         IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Path}"
                         Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:FileTransferNode}">
            <StackPanel>
                <TextBlock Text="Source" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}"
                         IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Source}"
                         Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Destination (file or folder)" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}"
                         IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Destination}"
                         Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="If the file exists" Style="{StaticResource NodeFieldLabel}" />
                <ComboBox FontSize="11" SelectedItem="{Binding IfExists}"
                          ItemsSource="{Binding IfExists, Converter={StaticResource EnumValues}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:FileWriteNode}">
            <StackPanel>
                <TextBlock Text="Path" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}"
                         IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Path}"
                         Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Append if exists" Margin="0,6,0,0"
                          FontSize="10" IsChecked="{Binding AppendIfExists}"
                          Foreground="{StaticResource TextMuted}" />
            </StackPanel>
        </DataTemplate>

        <!-- Shows the value in full, anchored top-left. A vertical scrollbar appears once the value
             is taller than the node; wider than the node is clipped, which is what Wrap and the
             resize grip are for. -->
        <!-- A read-only TextBox rather than a TextBlock, so the value can be selected and copied. -->
        <DataTemplate DataType="{x:Type n:OutputNode}">
            <DockPanel MinHeight="48">
                <CheckBox DockPanel.Dock="Bottom" Content="Wrap" Margin="0,5,0,0" FontSize="10"
                          IsChecked="{Binding Wrap}" Foreground="{StaticResource TextMuted}" />
                <Border Background="{StaticResource FieldBackground}" CornerRadius="3" Padding="5,3"
                        BorderBrush="#FF3E3E4A" BorderThickness="1" ClipToBounds="True">
                    <TextBox Text="{Binding DisplayText, Mode=OneWay}" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{StaticResource TextPrimary}" CaretBrush="Transparent"
                             SelectionBrush="#FF6FB3FF" FontFamily="Consolas" FontSize="11"
                             VerticalContentAlignment="Top"
                             TextWrapping="{Binding Wrap, Converter={StaticResource BoolToTextWrapping}}"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Hidden" />
                </Border>
            </DockPanel>
        </DataTemplate>

        <!-- Uniform scaling both ways, so a small QR code fills the node as well as a photo shrinks
             into it. Pixelated switches to nearest-neighbour for crisp modules and pixel art. -->
        <DataTemplate DataType="{x:Type n:ImageNode}">
            <DockPanel MinHeight="120">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
                    <CheckBox DockPanel.Dock="Right" Content="Pixelated" FontSize="10"
                              IsChecked="{Binding Pixelated}" Foreground="{StaticResource TextMuted}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondary}"
                                   Text="{Binding ImageFormat}" />
                        <TextBlock FontSize="10" Margin="6,0,0,0" Foreground="{StaticResource TextMuted}"
                                   Text="{Binding Source, ElementName=Preview, Converter={StaticResource ImageSize}}" />
                    </StackPanel>
                </DockPanel>
                <Border Background="{StaticResource FieldBackground}" CornerRadius="3" Padding="3"
                        BorderBrush="#FF3E3E4A" BorderThickness="1" ClipToBounds="True">
                    <Image x:Name="Preview" Stretch="Uniform"
                           Source="{Binding Preview, Converter={StaticResource BytesToImage}}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Pixelated}" Value="True">
                                        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Border>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:LengthNode}">
            <Border Background="{StaticResource FieldBackground}" CornerRadius="3" Padding="5,3"
                    BorderBrush="#FF3E3E4A" BorderThickness="1" ClipToBounds="True">
                <TextBox Text="{Binding DisplayText, Mode=OneWay}" IsReadOnly="True"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         Foreground="{StaticResource TextPrimary}" CaretBrush="Transparent"
                         SelectionBrush="#FF6FB3FF" FontFamily="Consolas" FontSize="11"
                         VerticalContentAlignment="Top" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:BooleanNode}">
            <CheckBox Content="{Binding Value}" IsChecked="{Binding Value}" FontSize="11"
                      Foreground="{StaticResource TextPrimary}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:HashNode}">
            <StackPanel>
                <TextBlock Text="Algorithm" Style="{StaticResource NodeFieldLabel}" />
                <ComboBox FontSize="11" SelectedItem="{Binding Algorithm}"
                          ItemsSource="{Binding Algorithm, Converter={StaticResource EnumValues}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:SubstringNode}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Start" Style="{StaticResource NodeFieldLabel}" />
                    <TextBox Style="{StaticResource NodeFieldTextBox}"
                             IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Start}"
                         Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Length" Style="{StaticResource NodeFieldLabel}" />
                    <TextBox Style="{StaticResource NodeFieldTextBox}"
                             IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Length}"
                         Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:ReplaceAllNode}">
            <StackPanel>
                <TextBlock Text="Find" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}"
                         IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Find}"
                         Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Replace with" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}"
                         IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Replace}"
                         Text="{Binding ReplaceWith, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:CountOccurrencesNode}">
            <StackPanel>
                <TextBlock Text="Find" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}"
                         IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Find}"
                         Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:SplitNode}">
            <StackPanel>
                <TextBlock Text="Separator" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}"
                         IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Separator}"
                         Text="{Binding Separator, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:JoinNode}">
            <StackPanel>
                <TextBlock Text="Separator" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}"
                         IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Separator}"
                         Text="{Binding Separator, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:EqualsNode}">
            <CheckBox Content="Ignore case" FontSize="10" IsChecked="{Binding IgnoreCase}"
                      Foreground="{StaticResource TextMuted}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:CompareNode}">
            <CheckBox Content="Ignore case" FontSize="10" IsChecked="{Binding IgnoreCase}"
                      Foreground="{StaticResource TextMuted}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:RandomBooleanNode}">
            <StackPanel>
                <TextBlock Text="Probability of true" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}"
                         IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Probability}"
                         Text="{Binding Probability, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <!-- Every trig node derives from TrigNode; the selector walks base types, so one template. -->
        <DataTemplate DataType="{x:Type n:TrigNode}">
            <CheckBox Content="Degrees" FontSize="10" IsChecked="{Binding Degrees}"
                      Foreground="{StaticResource TextMuted}" />
        </DataTemplate>

        <!-- The syntax is on the formula box's tooltip: written out, it would be taller than the node. -->
        <DataTemplate DataType="{x:Type n:ExpressionNode}">
            <StackPanel>
                <TextBlock Text="Formula" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}" FontFamily="Consolas" FontSize="12"
                         TextWrapping="Wrap" ToolTip="{Binding Hint}"
                         Text="{Binding Formula, UpdateSourceTrigger=PropertyChanged}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="X" Style="{StaticResource NodeFieldLabel}" />
                        <TextBox Style="{StaticResource NodeFieldTextBox}"
                                 IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired}, ConverterParameter=X}"
                                 Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Y" Style="{StaticResource NodeFieldLabel}" />
                        <TextBox Style="{StaticResource NodeFieldTextBox}"
                                 IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired}, ConverterParameter=Y}"
                                 Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Z" Style="{StaticResource NodeFieldLabel}" />
                        <TextBox Style="{StaticResource NodeFieldTextBox}"
                                 IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired}, ConverterParameter=Z}"
                                 Text="{Binding Z, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Text="W" Style="{StaticResource NodeFieldLabel}" />
                        <TextBox Style="{StaticResource NodeFieldTextBox}"
                                 IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired}, ConverterParameter=W}"
                                 Text="{Binding W, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <CheckBox Content="Degrees" FontSize="10" Margin="0,5,0,0" IsChecked="{Binding Degrees}"
                          Foreground="{StaticResource TextMuted}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:RoundNode}">
            <StackPanel>
                <TextBlock Text="Decimal places" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}"
                         IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Digits}"
                         Text="{Binding Digits, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:ClampNode}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Min" Style="{StaticResource NodeFieldLabel}" />
                    <TextBox Style="{StaticResource NodeFieldTextBox}"
                             IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Min}"
                             Text="{Binding Min, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Max" Style="{StaticResource NodeFieldLabel}" />
                    <TextBox Style="{StaticResource NodeFieldTextBox}"
                             IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Max}"
                             Text="{Binding Max, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:ConstantNode}">
            <ComboBox FontSize="11" SelectedItem="{Binding Constant}"
                      ItemsSource="{Binding Constant, Converter={StaticResource EnumValues}}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:Base64EncodeNode}">
            <CheckBox Content="URL-safe alphabet, no padding" FontSize="10" IsChecked="{Binding UrlSafe}"
                      Foreground="{StaticResource TextMuted}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:UrlEncodeNode}">
            <CheckBox Content="Form encoding (space as +)" FontSize="10" IsChecked="{Binding FormEncoding}"
                      Foreground="{StaticResource TextMuted}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:UrlDecodeNode}">
            <CheckBox Content="Form encoding (+ as space)" FontSize="10" IsChecked="{Binding FormEncoding}"
                      Foreground="{StaticResource TextMuted}" />
        </DataTemplate>

        <!-- The preview scales the PNG to the node without smoothing, so modules stay crisp. -->
        <DataTemplate DataType="{x:Type n:QrCodeNode}">
            <DockPanel MinHeight="150">
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Error correction" Style="{StaticResource NodeFieldLabel}" />
                        <ComboBox FontSize="11" SelectedItem="{Binding ErrorCorrection}"
                                  ItemsSource="{Binding ErrorCorrection, Converter={StaticResource EnumValues}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Pixels per module" Style="{StaticResource NodeFieldLabel}" />
                        <TextBox Style="{StaticResource NodeFieldTextBox}"
                                 Text="{Binding PixelsPerModule, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <Image Margin="0,6,0,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"
                       Source="{Binding Png, Converter={StaticResource BytesToImage}}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:BCryptHashNode}">
            <StackPanel>
                <TextBlock Text="Work factor (4-20)" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}"
                         IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter='Work Factor'}"
                         Text="{Binding WorkFactor, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:Pbkdf2Node}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Algorithm" Style="{StaticResource NodeFieldLabel}" />
                        <ComboBox FontSize="11" SelectedItem="{Binding Algorithm}"
                                  ItemsSource="{Binding Algorithm, Converter={StaticResource EnumValues}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Length (bytes)" Style="{StaticResource NodeFieldLabel}" />
                        <TextBox Style="{StaticResource NodeFieldTextBox}"
                                 Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Iterations" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}"
                         IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Iterations}"
                         Text="{Binding Iterations, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Salt (empty: random each run)" Style="{StaticResource NodeFieldLabel}" />
                <TextBox Style="{StaticResource NodeFieldTextBox}"
                         IsEnabled="{Binding Inputs, Converter={StaticResource PortNotWired},
                                     ConverterParameter=Salt}"
                         Text="{Binding Salt, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:GuidNode}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Version" Style="{StaticResource NodeFieldLabel}" />
                        <ComboBox FontSize="11" SelectedItem="{Binding Version}"
                                  ItemsSource="{Binding Version, Converter={StaticResource EnumValues}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Format" Style="{StaticResource NodeFieldLabel}" />
                        <ComboBox FontSize="11" SelectedItem="{Binding Format}"
                                  ItemsSource="{Binding Format, Converter={StaticResource EnumValues}}" />
                    </StackPanel>
                </Grid>
                <CheckBox Content="Uppercase" Margin="0,6,0,0" FontSize="10" IsChecked="{Binding Uppercase}"
                          Foreground="{StaticResource TextMuted}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type n:DateTimeNode}">
            <StackPanel>
