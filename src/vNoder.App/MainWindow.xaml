        <!-- ===== More display nodes ========================================================== -->

        <!-- Row virtualization stays on (the DataGrid default), so a long table costs only what is
             on screen. Columns are generated from the DataView; the headers are restored from the
             column captions in TableGrid_AutoGeneratingColumn, since a header like "a.b" would
             otherwise be read as a binding path. -->
        <DataTemplate DataType="{x:Type n:TableNode}">
            <DockPanel MinHeight="80">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
                    <CheckBox DockPanel.Dock="Right" Content="First row is the header" FontSize="10"
                              IsChecked="{Binding FirstRowIsHeader}" Foreground="{StaticResource TextMuted}" />
                    <TextBlock FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                               Text="{Binding Summary}" />
                </DockPanel>
                <Border Background="{StaticResource FieldBackground}" CornerRadius="3"
                        BorderBrush="#FF3E3E4A" BorderThickness="1" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Table, Converter={StaticResource TableToView}}"
                              AutoGeneratingColumn="TableGrid_AutoGeneratingColumn" />
                </Border>
            </DockPanel>
        </DataTemplate>

        <!-- The line is drawn in the plot area's own pixels (PlotPointsConverter), so it always fills
             the node, whatever the values' range, and a flat series is a flat line mid-height. -->
        <DataTemplate DataType="{x:Type n:PlotNode}">
            <DockPanel MinHeight="80">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Keep" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Foreground="{StaticResource TextMuted}" />
                        <TextBox Style="{StaticResource NodeFieldTextBox}" Width="48"
                                 Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                               Text="{Binding Summary}" />
                </DockPanel>
                <Border Background="{StaticResource FieldBackground}" CornerRadius="3" Padding="4"
                        BorderBrush="#FF3E3E4A" BorderThickness="1" ClipToBounds="True">
                    <Grid x:Name="PlotArea">
                        <Polyline Stroke="#FF6FB3FF" StrokeThickness="1.5" StrokeLineJoin="Round">
                            <Polyline.Points>
                                <MultiBinding Converter="{StaticResource PlotPoints}">
                                    <Binding Path="Points" />
                                    <Binding Path="ActualWidth" ElementName="PlotArea" />
                                    <Binding Path="ActualHeight" ElementName="PlotArea" />
                                </MultiBinding>
                            </Polyline.Points>
                        </Polyline>
                    </Grid>
                </Border>
            </DockPanel>
        </DataTemplate>

        <!-- Newest line first, so the latest entry is in view without scrolling. -->
        <DataTemplate DataType="{x:Type n:LogNode}">
            <DockPanel MinHeight="60">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Keep lines" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Foreground="{StaticResource TextMuted}" />
                        <TextBox Style="{StaticResource NodeFieldTextBox}" Width="48"
                                 Text="{Binding MaxLines, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <CheckBox Content="Timestamp" FontSize="10" VerticalAlignment="Center"
                              IsChecked="{Binding Timestamp}" Foreground="{StaticResource TextMuted}" />
                </DockPanel>
                <Border Background="{StaticResource FieldBackground}" CornerRadius="3" Padding="5,3"
                        BorderBrush="#FF3E3E4A" BorderThickness="1" ClipToBounds="True">
                    <TextBox Text="{Binding DisplayText, Mode=OneWay}" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{StaticResource TextPrimary}" CaretBrush="Transparent"
                             SelectionBrush="#FF6FB3FF" FontFamily="Consolas" FontSize="11"
                             VerticalContentAlignment="Top" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden" />
                </Border>
            </DockPanel>
        </DataTemplate>

        <!-- ===== Node shell ============================================================= -->

        <Style x:Key="NodeShell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource NodeBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource NodeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Style.Triggers>
                <!-- Order matters: a later active trigger wins, so error beats selected beats hover. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FF7C8497" />
                    <Setter Property="Background" Value="#FF32323D" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource NodeBorderSelected}" />
                </DataTrigger>
                <!-- One of its linked notes is hovered: the note's amber, so the pair reads together. -->
                <DataTrigger Binding="{Binding IsNoteHovered}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFE8C872" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource NodeBorderError}" />
                </DataTrigger>
                <!-- Skipped by the last pass: dimmed, which moves nothing, so the ports stay on their anchors. -->
                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
                <!-- Last: while a node is evaluating, its error from the previous run is stale. -->
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <!-- Colour only: a thicker border would move the port dots off their wire anchors,
                         which NodeMetrics derives from a 1px border. -->
                    <Setter Property="BorderBrush" Value="#FFF2C14E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The completion flash: a glow over the node that fades in fast and out slowly. It plays on
             IsFlashing's rising edge (RunFeedback), and must last as long as RunFeedback.FlashDuration. -->
        <Style x:Key="NodeFlash" TargetType="Border">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#FF7BD88F" />
            <Setter Property="Background" Value="#307BD88F" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding FlashFailed}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFF6B5E" />
                    <Setter Property="Background" Value="#40FF6B5E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.03" Value="1" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.128" Value="0">
                                        <EasingDoubleKeyFrame.EasingFunction>
                                            <QuadraticEase EasingMode="EaseIn" />
                                        </EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="NodeTemplate">
            <Grid SizeChanged="NodeShell_SizeChanged" MouseRightButtonUp="NodeShell_MouseRightButtonUp"
                  MouseEnter="Hoverable_MouseEnter" MouseLeave="Hoverable_MouseLeave">
                <Border Style="{StaticResource NodeShell}" Width="{Binding Width}">
                    <StackPanel>
                        <Border Height="26" CornerRadius="5,5,0,0" Cursor="SizeAll"
                                Background="{Binding Category, Converter={StaticResource CategoryBrush}}"
                                MouseLeftButtonDown="NodeHeader_MouseLeftButtonDown">
                            <DockPanel>
                                <!-- "×N": this node runs once per list item, N times in the last run. -->
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ItemBadge}" Margin="0,0,9,0"
                                           VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" Opacity="0.85"
                                           ToolTip="Runs once per item of a list input; the number is how many items the last run had.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemBadge}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Title}" Margin="9,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            </DockPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,6,0,0"
                                      ItemTemplate="{StaticResource PortRowTemplate}" />
                        <!-- Tag marks the area the resize grip sizes; Height is NaN (Auto) until resized. -->
                        <ContentControl Tag="Editor" Content="{Binding Model}" Margin="9,2,9,8"
                                        Height="{Binding ContentHeight}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        ContentTemplateSelector="{StaticResource NodeEditorSelector}" />
                        <TextBlock Text="{Binding Error}" Margin="9,0,9,8" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{StaticResource ErrorText}"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource NodeFlash}" Width="{Binding Width}" />
                <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                      Cursor="SizeNWSE" Fill="{StaticResource TextMuted}" Opacity="0.75"
                      Data="M 10,0 L 10,10 L 0,10 Z" ToolTip="Drag to resize"
                      Visibility="{Binding IsResizable, Converter={StaticResource BoolToVisibility}}"
                      MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" />
            </Grid>
        </DataTemplate>

        <!-- ===== Group box ============================================================== -->

        <!-- The box is not hit-testable, so hover comes from the workspace rather than IsMouseOver. -->
        <Style x:Key="GroupBox" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FF585A70" />
            <Setter Property="Background" Value="#1A6FB3FF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHovered}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource NodeBorderSelected}" />
                    <Setter Property="Background" Value="#2E6FB3FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNoteHovered}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFE8C872" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GroupHeaderBar" TargetType="Border">
            <Setter Property="Background" Value="#FF3A3D4E" />
            <Setter Property="CornerRadius" Value="7,7,0,0" />
            <Style.Triggers>
                <!-- Collapsed, the bar is the whole group, so it gets all four corners. -->
                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                    <Setter Property="CornerRadius" Value="7" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHovered}" Value="True">
                    <Setter Property="Background" Value="#FF4A4E64" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNoteHovered}" Value="True">
                    <Setter Property="Background" Value="#FF4A4E64" />
                    <Setter Property="BorderBrush" Value="#FFE8C872" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="GroupTemplate">
            <Grid>
                <!-- The box itself must not swallow clicks aimed at the canvas or its nodes. -->
                <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="8"
                        IsHitTestVisible="False" BorderThickness="1"
                        Style="{StaticResource GroupBox}"
                        Visibility="{Binding IsCollapsed,
                                     Converter={StaticResource InverseBoolToVisibility}}" />
                <!-- The entire bar is the drag handle: nothing inside it is hit-testable, and it
                     collapses on double-click. Renaming is on its context menu. -->
                <Border Width="{Binding Width}" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left"
                        Cursor="SizeAll" Style="{StaticResource GroupHeaderBar}"
                        ToolTip="Drag to move, double-click to collapse"
                        MouseLeftButtonDown="GroupHeader_MouseLeftButtonDown"
                        MouseRightButtonUp="GroupHeader_MouseRightButtonUp">
                    <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="{Binding MemberCountLabel}" Margin="8,0,0,0" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
                                   Visibility="{Binding IsCollapsed,
                                                Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ===== Notes ================================================================== -->

        <!-- Amber, dotted and straight: nothing else on the canvas looks like it, so a leader is
             never mistaken for a wire (wires are port-coloured Beziers, solid or dashed). -->
        <SolidColorBrush x:Key="NoteAccent" Color="#FFE8C872" />

        <DataTemplate x:Key="NoteLeaderTemplate">
            <Path Data="{Binding Leader}" Stroke="{StaticResource NoteAccent}"
                  StrokeThickness="{Binding DataContext.Scale,
                                    RelativeSource={RelativeSource AncestorType=Window},
                                    Converter={StaticResource ScaleToStroke}}"
                  StrokeDashArray="0 2" StrokeDashCap="Round" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" IsHitTestVisible="False"
                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <Path.Style>
                    <Style TargetType="Path">
                        <Setter Property="Opacity" Value="0.7" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>
        </DataTemplate>

        <Style x:Key="NoteShell" TargetType="Border">
            <Setter Property="Background" Value="#14E8C872" />
            <Setter Property="BorderBrush" Value="#33E8C872" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26E8C872" />
                    <Setter Property="BorderBrush" Value="#80E8C872" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource NoteAccent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A linked note: lit up with its target, as its target is with it. -->
        <Style x:Key="LinkedNoteShell" TargetType="Border" BasedOn="{StaticResource NoteShell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="#2EE8C872" />
                    <Setter Property="BorderBrush" Value="#CCE8C872" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A Note node: the same look, plus the selection highlight a node has. -->
        <Style x:Key="NoteNodeShell" TargetType="Border" BasedOn="{StaticResource NoteShell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource NodeBorderSelected}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NoteHandle" TargetType="Border">
            <Setter Property="Height" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeAll" />
        </Style>

        <Style x:Key="NoteText" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0,4,5" />
            <Setter Property="Foreground" Value="#FFEBDDB0" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="{StaticResource NodeBorderSelected}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <!-- Hidden, not disabled: a note sized smaller than its text scrolls it (middle-drag). -->
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        </Style>

        <!-- The resize grip shows only while the cursor is over the note, which is otherwise just text. -->
        <Style x:Key="NoteGrip" TargetType="Path">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,2,2" />
            <Setter Property="Cursor" Value="SizeNWSE" />
            <Setter Property="Fill" Value="{StaticResource NoteAccent}" />
            <Setter Property="Data" Value="M 8,0 L 8,8 L 0,8 Z" />
            <Setter Property="ToolTip" Value="Drag to resize" />
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
                             Value="True">
                    <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Mostly just text: a faint tint, and a slim top strip that is the drag handle. Height is NaN
             (Auto) until the note is resized, so a new note grows with its text. -->
        <DataTemplate x:Key="NoteTemplate">
            <Grid SizeChanged="Note_SizeChanged" MouseRightButtonUp="Note_MouseRightButtonUp"
                  MouseEnter="Hoverable_MouseEnter" MouseLeave="Hoverable_MouseLeave">
                <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="4" BorderThickness="1"
                        Style="{StaticResource LinkedNoteShell}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource NoteHandle}"
                                ToolTip="Drag to move; right-click to delete. N hides all notes."
                                MouseLeftButtonDown="NoteHandle_MouseLeftButtonDown">
                            <Rectangle Width="24" Height="2" RadiusX="1" RadiusY="1" VerticalAlignment="Center"
                                       Fill="{StaticResource NoteAccent}" Opacity="0.5" />
                        </Border>
                        <TextBox Style="{StaticResource NoteText}" Loaded="NoteText_Loaded"
                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </Border>
                <Path Style="{StaticResource NoteGrip}" MouseLeftButtonDown="NoteGrip_MouseLeftButtonDown" />
            </Grid>
        </DataTemplate>

        <!-- The Note node: no header and no ports, drawn like a linked note, but a node in every other
             way (it selects, moves, groups and copies like one). The editor keeps Tag="Editor" and a
             MinHeight on its root, which the node resize grip relies on. -->
        <DataTemplate x:Key="NoteNodeTemplate">
            <!-- N hides these along with the linked notes. -->
            <Grid SizeChanged="NodeShell_SizeChanged" MouseRightButtonUp="NodeShell_MouseRightButtonUp"
                  Visibility="{Binding DataContext.NotesVisible,
                               RelativeSource={RelativeSource AncestorType=Window},
                               Converter={StaticResource BoolToVisibility}}">
                <Border Width="{Binding Width}" CornerRadius="4" BorderThickness="1"
                        Style="{StaticResource NoteNodeShell}">
                    <StackPanel>
                        <Border Style="{StaticResource NoteHandle}" ToolTip="Drag to move"
                                MouseLeftButtonDown="NodeHeader_MouseLeftButtonDown">
                            <Rectangle Width="24" Height="2" RadiusX="1" RadiusY="1" VerticalAlignment="Center"
                                       Fill="{StaticResource NoteAccent}" Opacity="0.5" />
                        </Border>
                        <ContentControl Tag="Editor" Content="{Binding Model}" Height="{Binding ContentHeight}"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <TextBox Style="{StaticResource NoteText}" MinHeight="20"
                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </StackPanel>
                </Border>
                <Path Style="{StaticResource NoteGrip}" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" />
            </Grid>
        </DataTemplate>

        <p:NodeTemplateSelector x:Key="NodeTemplateSelector" Node="{StaticResource NodeTemplate}"
                                Note="{StaticResource NoteNodeTemplate}" />

    </Window.Resources>

    <DockPanel>

        <!-- Slim toolbar: the only permanent chrome. -->
        <Border DockPanel.Dock="Top" Height="40" Background="{StaticResource ToolbarBackground}"
                BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="10,0">
                <Button DockPanel.Dock="Left" Content="New" VerticalAlignment="Center" ToolTip="Ctrl+N"
                        Style="{StaticResource ToolbarButton}" Command="ApplicationCommands.New" />
                <Button DockPanel.Dock="Left" Content="Open" VerticalAlignment="Center" ToolTip="Ctrl+O"
                        Style="{StaticResource ToolbarButton}" Command="ApplicationCommands.Open" />
                <Button DockPanel.Dock="Left" Content="Import" VerticalAlignment="Center"
                        ToolTip="Add another graph file to this one (Ctrl+I)"
                        Style="{StaticResource ToolbarButton}" Command="{x:Static local:MainWindow.ImportCommand}" />
                <Button DockPanel.Dock="Left" Content="Save" VerticalAlignment="Center" ToolTip="Ctrl+S"
                        Style="{StaticResource ToolbarButton}" Command="ApplicationCommands.Save" />
                <Border DockPanel.Dock="Left" Width="1" Margin="4,10,10,10"
                        Background="{StaticResource ChromeBorder}" />
                <!-- Bound to the workspace, not to the routed Undo: a toolbar click always means the
                     graph, even while a node's text box still holds keyboard focus. -->
                <Button DockPanel.Dock="Left" Content="Undo" VerticalAlignment="Center"
                        ToolTip="{Binding UndoToolTip}" ToolTipService.ShowOnDisabled="True"
                        Style="{StaticResource ToolbarButton}" Command="{Binding UndoCommand}" />
                <Button DockPanel.Dock="Left" Content="Redo" VerticalAlignment="Center"
                        ToolTip="{Binding RedoToolTip}" ToolTipService.ShowOnDisabled="True"
                        Style="{StaticResource ToolbarButton}" Command="{Binding RedoCommand}" />
                <Border DockPanel.Dock="Left" Width="1" Margin="4,10,10,10"
                        Background="{StaticResource ChromeBorder}" />
                <Button DockPanel.Dock="Left" VerticalAlignment="Center" ToolTip="Show or hide all notes (N)"
                        Style="{StaticResource ToolbarButton}" Content="{Binding NotesButtonText}"
                        Command="{Binding ToggleNotesCommand}" />
                <Border DockPanel.Dock="Left" Width="1" Margin="4,10,10,10"
                        Background="{StaticResource ChromeBorder}" />
                <Button DockPanel.Dock="Left" Content="Run Once" VerticalAlignment="Center" ToolTip="Ctrl+R"
                        Style="{StaticResource ToolbarButton}" Command="{Binding RunOnceCommand}" />
                <Button DockPanel.Dock="Left" VerticalAlignment="Center" ToolTip="Ctrl+Shift+R"
                        Style="{StaticResource RunToggleButton}"
                        Content="{Binding ContinuousButtonText}"
                        Command="{Binding ToggleContinuousCommand}" />
                <!-- Tick rate for continuous runs: graph-level, so it needs no node. -->
                <TextBox DockPanel.Dock="Left" VerticalAlignment="Center" Width="56" Padding="4,3"
                         Style="{StaticResource NodeFieldTextBox}" FontSize="11"
                         ToolTip="Continuous run interval, in milliseconds"
                         Text="{Binding IntervalMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="6,0,0,0"
                           FontSize="11" Foreground="{StaticResource TextMuted}" Text="ms" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                           FontSize="11" Foreground="{StaticResource TextMuted}"
                           Text="{Binding Scale, StringFormat={}{0:P0}}" />
                <TextBlock />
            </DockPanel>
        </Border>

        <!-- Status line: the running commentary belongs out of the way, at the bottom. -->
        <Border DockPanel.Dock="Bottom" Height="24" Background="{StaticResource ToolbarBackground}"
                BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,1,0,0">
            <DockPanel Margin="10,0">
                <!-- Live iteration count and elapsed time while a continuous run is going. -->
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                           FontSize="11" FontWeight="SemiBold" Foreground="#FFFF6B5E"
                           Text="{Binding RunProgressText}"
                           Visibility="{Binding IsRunningContinuously,
                                        Converter={StaticResource BoolToVisibility}}" />
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="11" Foreground="{StaticResource TextSecondary}"
                           Text="{Binding StatusText}" />
            </DockPanel>
        </Border>

        <!-- Workspace. Mouse handling lives on this host; the scene beneath it carries the transform. -->
        <Grid x:Name="WorkspaceHost" ClipToBounds="True" Background="{StaticResource CanvasBackground}"
              Focusable="True"
              MouseLeftButtonDown="WorkspaceHost_MouseLeftButtonDown"
              MouseDown="WorkspaceHost_MouseDown"
              MouseMove="WorkspaceHost_MouseMove"
              MouseUp="WorkspaceHost_MouseUp"
              MouseWheel="WorkspaceHost_MouseWheel"
              MouseLeave="WorkspaceHost_MouseLeave"
              LostMouseCapture="WorkspaceHost_LostMouseCapture"
              SizeChanged="WorkspaceHost_SizeChanged">

            <Rectangle x:Name="GridBackdrop" IsHitTestVisible="True">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" ViewportUnits="Absolute" Stretch="None">
                        <DrawingBrush.Viewport>
                            <MultiBinding Converter="{StaticResource GridViewport}">
                                <Binding Path="Scale" />
                                <Binding Path="OffsetX" />
                                <Binding Path="OffsetY" />
                            </MultiBinding>
                        </DrawingBrush.Viewport>
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#FF32323E">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- One wrapper carries the zoom/pan transform, so wires and nodes cannot drift apart.
                 Wires are declared first and therefore render beneath the nodes. -->
            <Grid x:Name="SceneRoot" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                        <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

                <!-- Wires are bare DrawingVisuals, culled to the viewport, rather than an element each;
                     see WireLayer. On a Canvas, like everything in scene space, so no layout clip. -->
                <Canvas>
                    <p:WireLayer Links="{Binding Links}" Scale="{Binding Scale}"
                                 Viewport="{Binding VisibleGraphRect}" />
                </Canvas>

                <!-- On a Canvas, not loose in the Grid. A Grid measures its children against the
                     viewport, so a wire longer than the window has its DesiredSize clamped and WPF
                     applies a layout clip at that size, cutting it off at a hard edge in scene
                     coordinates. A Canvas measures children with infinite space, so no clip. -->
                <Canvas>
                    <Path Data="{Binding PreviewGeometry}" Stroke="{StaticResource TextSecondary}"
                          StrokeThickness="{Binding Scale, Converter={StaticResource ScaleToStroke}}"
                          StrokeDashArray="4 3" IsHitTestVisible="False" />
                </Canvas>

                <!-- Note leaders run beneath the nodes, so one never crosses a node's body. -->
                <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource NoteLeaderTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Virtualized: only nodes near the viewport have visuals. See NodeRealizer. -->
                <ItemsControl ItemsSource="{Binding RealizedNodes}" ItemTemplateSelector="{StaticResource NodeTemplateSelector}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            <Setter Property="Visibility"
                                    Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

                <!-- Notes sit on top: they are annotations over the graph. Few, so not virtualized. -->
                <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource NoteTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            <Setter Property="Visibility"
                                    Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </Grid>

            <!-- Marquee is drawn in screen space, so it needs no transform maths. -->
            <Canvas x:Name="Overlay" IsHitTestVisible="False">
                <Rectangle x:Name="Marquee" Visibility="Collapsed" StrokeThickness="1"
                           Stroke="{StaticResource NodeBorderSelected}" Fill="#206FB3FF" />
            </Canvas>

            <!-- Add-node search: the only node catalog, opened at the cursor by double-click. -->
            <Popup x:Name="SearchPopup" Placement="Relative" PlacementTarget="{Binding ElementName=WorkspaceHost}"
                   HorizontalOffset="{Binding SearchScreenX}" VerticalOffset="{Binding SearchScreenY}"
                   IsOpen="{Binding IsSearchOpen, Mode=TwoWay}" StaysOpen="False"
                   AllowsTransparency="True" Opened="SearchPopup_Opened">
                <Border Width="320" Background="{StaticResource PopupBackground}" CornerRadius="6"
                        BorderBrush="#FF4A4A58" BorderThickness="1" Padding="6">
                    <StackPanel>
                        <TextBox x:Name="SearchBox" Style="{StaticResource NodeFieldTextBox}" Padding="6,4"
                                 FontSize="12" PreviewKeyDown="SearchBox_PreviewKeyDown"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                        <!-- Says why the list is short when a dropped wire narrowed it. -->
                        <TextBlock Margin="2,6,2,0" FontSize="10" Foreground="{StaticResource TextMuted}"
                                   Text="{Binding SearchFilterLabel}"
                                   Visibility="{Binding IsSearchFiltered,
                                                Converter={StaticResource BoolToVisibility}}" />
                        <ListBox x:Name="SearchList" MaxHeight="280" Margin="0,6,0,0" Background="Transparent"
                                 BorderThickness="0" ItemsSource="{Binding SearchResults}"
                                 SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                 PreviewMouseLeftButtonUp="SearchList_PreviewMouseLeftButtonUp"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="{Binding Category}" Margin="8,0,0,0" FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMuted}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="10" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Popup>

        </Grid>
    </DockPanel>
</Window>
