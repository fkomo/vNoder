<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\vNoder.Core\vNoder.Core.csproj" />
    <ProjectReference Include="..\vNoder.Nodes\vNoder.Nodes.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
