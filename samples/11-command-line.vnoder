  "notes": [
    {
      "id": "11000000-0000-4000-8000-0000000000f3",
      "target": "11000000-0000-4000-8000-000000000010",
      "x": 236,
      "y": 22,
      "text": "--name sets this; without it Value is the default, world, and Found is false. Tick Required and vnoder-cli refuses to run without it."
    },
    {
      "id": "11000000-0000-4000-8000-0000000000f1",
      "target": "11000000-0000-4000-8000-000000000006",
      "x": 0,
      "y": -90,
      "text": "Delay is the sleep: it waits, then passes its value on. Its Run If comes from the first write\u0027s Done, so the pause falls between the two lines."
    },
    {
      "id": "11000000-0000-4000-8000-0000000000f2",
      "target": "11000000-0000-4000-8000-00000000000e",
      "x": 0,
      "y": -90,
      "text": "Try: vnoder-cli samples/11-command-line.vnoder; echo $LASTEXITCODE (PowerShell) or echo %ERRORLEVEL% (cmd)."
    },
    {
      "id": "16fa6a15-b2ac-4f26-a9ef-5dd2265595c4",
      "target": "072aac58-87a5-40be-b826-a1eb0c253e3b",
      "x": 0,
      "y": -110,
      "text": "Pipe something in: type notes.txt | vnoder-cli samples/11-command-line.vnoder. With nothing piped in (and always in the editor) Found is false, so the line is not written."
    }
  ]
}