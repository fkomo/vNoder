  "notes": [
    {
      "id": "c8c898f4-4b95-4078-bb7a-5f4f57a6408f",
      "target": "6e1eb264-330c-4119-b3c9-b3ef72138a0c",
      "x": 0,
      "y": -110,
      "text": "Every\u0027s Due into File Write\u0027s Run If: a line every 3 seconds. File Write\u0027s Done into File Tail\u0027s Run If, so the tail reads after the write."
    },
    {
      "id": "5619e0de-025d-4ce8-8b83-7263b1f68c99",
      "target": "53b43cfb-195b-4cd0-9420-3e03a75f197e",
      "x": 0,
      "y": -110,
      "text": "Switch: ERROR and WARN have their own answer, anything else gets the default."
    },
    {
      "id": "0a7476c5-e602-4950-918c-10c8acc5e644",
      "target": "2be32efc-9b78-44cd-a2e0-0b417ccb3f9c",
      "x": 0,
      "y": -110,
      "text": "Cron Due fires once a minute; Difference to its Next, through Duration Format, says how long until the next one."
    }
  ]
}